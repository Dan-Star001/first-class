<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello EJS</h1>

    <h3>My age is <%= age %> </h3>

     <% if( age < 20) {  %>
        <p>You are young</p>
    <%} else { %>
        <p>You are an adult</p>
    <% } %>


   <% for(i=0; i <= 10; i++) { %>
        <p><%= i %></p>
    <%} %>


    <% users.map((user) => { %>
        <span><%=user.name%></span>
        <span><%=user.age%></span>
        <br>
    <% }) %>



    





    

</body>
</html>